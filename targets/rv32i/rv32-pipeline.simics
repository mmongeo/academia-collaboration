decl {
    ! RV32I course machine with the pipelined core from
    ! modules/rv32-pipeline, RAM at address 0, and a program loaded into RAM.
    ! Run the program with "run"; it stops at its EBREAK.

    params from "rv32.simics" except cpu_class
}

run-script "%script%/rv32.simics" cpu_class = "rv32-pipeline"
