decl {
    ! RV32I course machine: one core from modules/rv32-atomic or
    ! modules/rv32-pipeline, RAM at address 0, and a program loaded into RAM.
    ! Run the program with "run"; it stops at its EBREAK. rv32-atomic.simics
    ! and rv32-pipeline.simics run this script with cpu_class set.

    param cpu_class : string = "rv32-atomic"
    ! Processor class: "rv32-atomic" or "rv32-pipeline". The core class is the
    ! same name followed by "-core".
    param program : file("*") or nil = "%script%/programs/all-instructions.txt"
    ! Program to run: an assembly program (.txt), written into memory by
    ! load_program() in the core module's txt_loader.py. NIL loads nothing.
    param load_address : int = 0
    ! Address the program is loaded at; execution starts there.
    param ram_size : int = 0x100000
    ! Size in bytes of the RAM at address 0.
    param freq_mhz : float = 100.0
    ! Clock frequency of the core.
}

run-script "%script%/rv32-system.py"

if $program != NIL {
    echo "RV32I course machine: " + $cpu_class + " running " + $program
}
